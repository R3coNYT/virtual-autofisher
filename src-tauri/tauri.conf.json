{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual AutoFisher",
  "version": "../package.json",
  "identifier": "com.r3con.virtualautofisher",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Virtual AutoFisher",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#0a1628"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.discordapp.com https://media.discordapp.net data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["icons/icon.png", "icons/icon-alert.png"]
  }
}
