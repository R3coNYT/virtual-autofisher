{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/shared/**/*",
    "src/renderer/applyGamePatch.ts",
    "src/renderer/resolveFirstScreen.ts",
    "src/renderer/logBuffer.ts",
    "src/renderer/format.ts",
    "src/renderer/settingsBounds.ts",
    "src/renderer/discordMarkdown.ts",
    "tests/**/*",
    "src/renderer/api.ts",
    "src/renderer/env.d.ts"
  ]
}
